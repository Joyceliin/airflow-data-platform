# =============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - AIRFLOW DATA PLATFORM
# Copie este arquivo para .env e preencha os valores antes de executar.
# NUNCA comite o arquivo .env no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# BUILD DA IMAGEM - Container Registry
# Ex.: GITLAB_REGISTRY=gitlab.example.com:5050
# -----------------------------------------------------------------------------
GITLAB_REGISTRY=<registry-host>
GITLAB_PROJECT_PATH=<grupo>/airflow-data-platform
IMAGE_NAME=airflow-platform
IMAGE_TAG=latest

# Credenciais para push: use Personal Access Token com scopes read_registry e write_registry.
# Em CI use variáveis protegidas.
GITLAB_USER=<seu-usuario-gitlab>
GITLAB_TOKEN=<seu-personal-access-token>

# -----------------------------------------------------------------------------
# ORACLE INSTANT CLIENT
# Versão dos zips presentes na pasta plugin/
# -----------------------------------------------------------------------------
ORACLE_IC_VERSION=23.26.1.0.0

# -----------------------------------------------------------------------------
# POSTGRESQL (backend do Airflow)
# -----------------------------------------------------------------------------
POSTGRES_HOST=<host-postgres>
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<senha-postgres-segura>

# -----------------------------------------------------------------------------
# REDIS (broker Celery)
# -----------------------------------------------------------------------------
REDIS_HOST=<host-redis>
REDIS_PASSWORD=<senha-redis-segura>

# -----------------------------------------------------------------------------
# AIRFLOW - Chaves de segurança
# Gere FERNET_KEY com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
# Gere JWT_SECRET com: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=<fernet-key-base64>
AIRFLOW__WEBSERVER__SECRET_KEY=<secret-key-hex>
AIRFLOW__API_AUTH__JWT_SECRET=<jwt-secret-hex>

# -----------------------------------------------------------------------------
# AIRFLOW - Usuário admin inicial
# -----------------------------------------------------------------------------
AIRFLOW_WWW_USER_USERNAME=airflow-admin
AIRFLOW_WWW_USER_PASSWORD=<senha-admin-segura>

# UID do processo airflow dentro do container (padrão: 50000)
AIRFLOW_UID=50000

# -----------------------------------------------------------------------------
# AIRFLOW - SMTP (notificações por e-mail)
# -----------------------------------------------------------------------------
AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
AIRFLOW__SMTP__SMTP_USER=<usuario-smtp>
AIRFLOW__SMTP__SMTP_PASSWORD=<senha-smtp>
AIRFLOW__SMTP__SMTP_MAIL_FROM=<email-remetente>

# -----------------------------------------------------------------------------
# AIRFLOW - Pacotes pip adicionais em runtime (opcional)
# Exemplo: _PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-slack==8.0.0
# -----------------------------------------------------------------------------
_PIP_ADDITIONAL_REQUIREMENTS=
